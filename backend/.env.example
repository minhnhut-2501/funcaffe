APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000

# Múi giờ quyết định ranh giới "hôm nay / tháng này" của mọi số liệu doanh thu.
# Để trống hoặc đặt UTC sẽ khiến doanh thu bán từ 0h đến 7h sáng bị tính sang ngày hôm trước.
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# MongoDB
MONGODB_DSN=mongodb://127.0.0.1:27017
MONGODB_DATABASE=funcafe
# Bật transaction cho MongoDB. CHỈ đặt true khi Mongo chạy replica set / Atlas.
# Mongo standalone không hỗ trợ transaction -> để false.
MONGODB_TRANSACTIONS=false

# Production (hosting free) dùng token Sanctum, không cần session/cache/queue bền:
#   SESSION_DRIVER=array, CACHE_STORE=array, QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# GỬI EMAIL (đặt lại mật khẩu + trả lời tin nhắn liên hệ).
#
# Chưa cấu hình thì hệ thống KHÔNG im lặng: liên kết đặt lại mật khẩu được ghi vào
# storage/logs/laravel.log để còn thử được luồng ở máy phát triển. Nhưng bản đã
# triển khai mà để nguyên thế này thì người quên mật khẩu vĩnh viễn không nhận được
# gì — máy chủ vẫn trả "nếu email tồn tại, bạn sẽ nhận được hướng dẫn" như thường.
#
# BẬT gửi thật (Gmail):
#   1. Bật xác minh 2 bước cho tài khoản Google.
#   2. Google Account > Security > App passwords -> tạo mật khẩu ứng dụng 16 ký tự.
#   3. Điền MAIL_PASSWORD bằng mật khẩu đó (KHÔNG phải mật khẩu đăng nhập Google).
#   4. MAIL_FROM_ADDRESS phải trùng MAIL_USERNAME, nếu không Gmail từ chối gửi.
#
# Đổi MAIL_MAILER thành 'log' khi muốn tắt gửi thật mà vẫn xem được nội dung thư.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM_ADDRESS=your-address@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# ==== BẢN TRIỂN KHAI (Render) PHẢI DÙNG RESEND, KHÔNG DÙNG ĐƯỢC SMTP Ở TRÊN ====
#
# Render CHẶN mọi kết nối ra cổng SMTP (25/465/587) trên dịch vụ web gói miễn phí, từ
# 26/09/2025. Không phải chặn thẳng mà là nuốt gói tin: đo được lượt gọi quên mật khẩu
# treo đúng 61 giây rồi hết giờ, trong khi lượt gọi không gửi thư chỉ mất 0,9 giây.
# Nâng lên gói trả phí thì 465/587 mở lại (riêng cổng 25 chặn ở mọi gói).
#
# Resend đi qua HTTPS cổng 443 nên không dính lệnh chặn đó. Đặt trên Render:
#   MAIL_MAILER=resend
#   RESEND_API_KEY=re_...            (resend.com > API keys, quyền Sending access)
#   MAIL_FROM_ADDRESS=no-reply@funcafe.pro
#
# MAIL_FROM_ADDRESS BẮT BUỘC thuộc tên miền đã xác thực ở Resend. Để nguyên một địa chỉ
# @gmail.com là bị từ chối — mình không sở hữu gmail.com.
RESEND_API_KEY=

# Hòm thư có người đọc, nhận thư khi khách bấm Trả lời (địa chỉ gửi là no-reply nên
# không ai mở). Bỏ trống thì thư trả lời của khách đi vào hư không.
MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudinary — lưu ảnh upload (lấy tại https://cloudinary.com → Dashboard).
# Bỏ trống ở local sẽ tự fallback lưu ảnh vào disk public.
CLOUDINARY_URL=

# CORS — ai được phép gọi API này từ trình duyệt.
#
# `*` chỉ dùng ở LOCAL. Trên bản triển khai PHẢI đặt đúng tên miền frontend, phẩy
# ngăn cách nếu có nhiều: https://funcafe.vercel.app
# Để `*` khi đã lên mạng nghĩa là bất kỳ trang web nào cũng gọi được API bằng token
# của người dùng đang đăng nhập.
CORS_ALLOWED_ORIGINS=*

# Sanctum — hạn dùng của token đăng nhập, tính bằng PHÚT. Bỏ trống = 43200 (30 ngày),
# xem chú thích chính sách trong config/sanctum.php. Đặt rỗng hẳn là token sống mãi:
# một token bị chép lại sẽ mở được tài khoản đó vĩnh viễn.
SANCTUM_EXPIRATION_MINUTES=43200

# Các tên miền được coi là "cùng nhà" (dùng cookie phiên thay vì token). Dự án này
# xác thực bằng Bearer token nên bỏ trống là đúng. Chỉ điền nếu sau này frontend và
# backend dùng chung tên miền và bạn muốn chuyển sang cookie.
SANCTUM_STATEFUL_DOMAINS=

# Thuế VAT áp khi mua gói (%). Bỏ trống = 10.
VAT_RATE=10

# Trợ lý AI (gói Pro Max) — key miễn phí tại https://aistudio.google.com
# THIẾU KEY NÀY thì chat box và phân tích doanh thu bằng AI không chạy, phần còn
# lại của hệ thống vẫn bình thường.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Mô hình dự phòng, dùng khi mô hình chính trả 503 (đang nghẽn) hoặc 429 (cạn hạn
# ngạch). Bậc miễn phí đếm hạn ngạch RIÊNG cho từng mô hình nên đây là đường lui
# thật, không phải hình thức. Đo lúc dựng tính năng: dòng lite trả lời ~0,8 giây
# trong khi gemini-flash-latest đang 503.
GEMINI_MODEL_FALLBACK=gemini-flash-lite-latest
# Hạn chờ mỗi lời gọi Gemini (giây). Phải nhỏ hơn hạn chạy của tiến trình PHP —
# GeminiService tự nới bằng set_time_limit() nên thường không cần đụng tới.
GEMINI_TIMEOUT=45

# Trần tần suất cho trợ lý AI tư vấn ở trang công khai (gọi được khi CHƯA đăng nhập).
# Hai dòng đầu tính theo từng khách; dòng thứ ba tính trên toàn hệ thống và là lớp
# giữ hạn ngạch Gemini miễn phí cho chủ quán trả tiền — đặt thấp hơn hẳn quota thật.
AI_MOI_PHUT=6
AI_MOI_NGAY=40
AI_CHUNG_MOI_NGAY=120

# Bộ chứng chỉ CA cho các lời gọi HTTPS ra ngoài (Gemini, MoMo).
# Linux/Render: ĐỂ TRỐNG (dùng cert hệ thống). Windows local thiếu cert thì tải
# cacert.pem về và trỏ tới đây, nếu không sẽ gặp cURL error 60.
CA_BUNDLE=
# Riêng cho lời gọi Gemini, khi cần trỏ tới một bộ chứng chỉ khác CA_BUNDLE ở trên.
# Bỏ trống thì Gemini dùng chung CA_BUNDLE.
GEMINI_CA_BUNDLE=

# VNPay sandbox — đăng ký tại https://sandbox.vnpayment.vn để lấy TmnCode + HashSecret
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# BỎ TRỐNG khi deploy: nó tự suy ra từ APP_URL. Chỉ đặt tay ở local.
VNPAY_RETURN_URL=http://localhost:8000/api/payments/vnpay/return

# MoMo (môi trường thử nghiệm) — bộ khóa test công khai nằm trong code mẫu chính
# thức tại https://github.com/momo-wallet/payment. Tài khoản thật: business.momo.vn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
# Hai dòng dưới cũng BỎ TRỐNG khi deploy — tự suy ra từ APP_URL. Đặt sai thành
# localhost là cổng chuyển hướng về máy bạn và giao dịch treo vĩnh viễn.
MOMO_REDIRECT_URL=http://localhost:8000/api/payments/momo/return
MOMO_IPN_URL=http://localhost:8000/api/payments/momo/ipn
# captureWallet = tra bang vi MoMo (can app MoMo Test tren dien thoai/gia lap)
# payWithATM    = tra bang the ATM ngay tren trinh duyet, khong can app
MOMO_REQUEST_TYPE=captureWallet
